---
// The Projects tab: featured projects as wide spotlight cards, then the rest
// in a grid. Optional "What's this?" card on the right (src/content/profile.yaml).
import ProjectCard from "./ProjectCard.astro";
import Icon from "./Icon.astro";
import { getProjects, getProfile } from "../lib/content";

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const { projects_card: info } = await getProfile();
---

<h2 class="tab-heading">Projects</h2>
<div class:list={["projects-layout", { "has-info": info.text }]}>
  {info.text && (
    <aside class="info-card" aria-labelledby="info-title">
      <h3 id="info-title"><Icon name="info" /> {info.title}</h3>
      <p>{info.text}</p>
    </aside>
  )}
  <div class="project-stack">
    {featured.map((project) => <ProjectCard project={project} wide />)}
    {others.length > 0 && (
      <div class="grid">
        {others.map((project) => <ProjectCard project={project} />)}
      </div>
    )}
    {projects.length === 0 && <p class="empty">Projects coming soon.</p>}
  </div>
</div>
