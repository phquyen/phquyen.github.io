---
// The Projects tab: one card per file in src/content/projects/,
// plus the "What's this?" card on the right (text in src/content/profile.yaml).
import ProjectCard from "./ProjectCard.astro";
import Icon from "./Icon.astro";
import { getProjects, getProfile } from "../lib/content";

const projects = await getProjects();
const { projects_card: info } = await getProfile();
---

<h2 class="sr-only">Projects</h2>
<div class:list={["projects-layout", { "has-info": info.text }]}>
  {info.text && (
    <aside class="info-card" aria-labelledby="info-title">
      <h3 id="info-title"><Icon name="info" /> {info.title}</h3>
      <p>{info.text}</p>
    </aside>
  )}
  {projects.length > 0 ? (
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  ) : (
    <p class="empty">Projects coming soon.</p>
  )}
</div>
