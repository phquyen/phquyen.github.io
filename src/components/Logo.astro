---
// The alpaca logo (an original drawing). Colours come from theme.css:
// --logo-wool, --logo-muzzle, --logo-ink, --logo-line, and --color-accent for the pink.
// The browser-tab icon is a copy of this drawing in public/favicon.svg.
type Props = { size?: number; class?: string };
const { size = 32, class: className } = Astro.props;

// Shapes shared by the outline layer and the wool layer.
const neck = `
  <path d="M22 44 h20 v20 h-20 z"/>
  <circle cx="22.5" cy="48.5" r="3"/><circle cx="22.5" cy="54.5" r="3"/><circle cx="22.5" cy="60.5" r="3"/>
  <circle cx="41.5" cy="48.5" r="3"/><circle cx="41.5" cy="54.5" r="3"/><circle cx="41.5" cy="60.5" r="3"/>`;
const head = `
  <path d="M22.5 22 C16.5 17.5 13 10.5 13.5 4 C19.5 5.5 25.5 11.5 27.5 18.5 Z"/>
  <path d="M41.5 22 C47.5 17.5 51 10.5 50.5 4 C44.5 5.5 38.5 11.5 36.5 18.5 Z"/>
  <ellipse cx="32" cy="35" rx="13" ry="12.5"/>
  <circle cx="25" cy="22.5" r="5.2"/><circle cx="32" cy="19.5" r="6"/><circle cx="39" cy="22.5" r="5.2"/>
  <circle cx="20.5" cy="27.5" r="4.2"/><circle cx="43.5" cy="27.5" r="4.2"/>
  <circle cx="28.5" cy="15.5" r="3.5"/><circle cx="35.5" cy="15.5" r="3.5"/>`;
---

<svg class:list={["logo", className]} width={size} height={size} viewBox="-2 -2 68 68" aria-hidden="true" focusable="false">
  <g class="logo-line" set:html={neck} />
  <g class="logo-line" transform="rotate(-12 32 44)" set:html={head} />
  <g class="logo-wool" set:html={neck} />
  <g class="logo-wool" transform="rotate(-12 32 44)" set:html={head} />
  <!-- scarf -->
  <path class="logo-pink" d="M19.5 46 Q32 50.5 44.5 46 L44.5 51.5 Q32 56 19.5 51.5 Z" />
  <path class="logo-pink" d="M35 52 L41 52 L42.5 62 L36.5 63 Z" />
  <path class="logo-fold" d="M36.5 56 L41.8 55.4 M37 59.4 L42.2 58.8" />
  <!-- face -->
  <g transform="rotate(-12 32 44)">
    <path class="logo-pink" d="M22.6 18.8 C19.3 15.8 17.2 11.6 17 7.8 C20.6 9.3 23.6 12.8 24.8 16.8 Z" />
    <path class="logo-pink" d="M41.4 18.8 C44.7 15.8 46.8 11.6 47 7.8 C43.4 9.3 40.4 12.8 39.2 16.8 Z" />
    <ellipse class="logo-muzzle" cx="32" cy="39.5" rx="7.2" ry="5.6" />
    <path class="logo-ink" d="M24.6 33 q2.4 -2.8 4.8 0" />
    <path class="logo-ink" d="M34.6 33 q2.4 -2.8 4.8 0" />
    <circle class="logo-pink" cx="22.8" cy="38.6" r="2.6" />
    <circle class="logo-pink" cx="41.2" cy="38.6" r="2.6" />
    <ellipse class="logo-nose" cx="32" cy="37.6" rx="1.9" ry="1.3" />
    <path class="logo-ink" d="M32 38.6 v1.6 M29.4 40.4 q1.3 1.6 2.6 0 q1.3 1.6 2.6 0" />
  </g>
</svg>
