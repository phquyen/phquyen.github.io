---
// Shared page frame: <head>, header (logo + theme toggle), footer.
// No menu links: the buttons and tabs under the headline already cover them.
// Layout code: to change text, edit src/content/ instead.
import "../styles/theme.css";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { getProfile } from "../lib/content";

type Props = {
  title?: string; // page title; your name is added automatically
  description?: string;
  canonical?: string; // the main address of this page, if it has two
};

const profile = await getProfile();
const { title, description = profile.bio, canonical = Astro.url.pathname } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
const year = new Date().getFullYear();

const links = [
  { label: "GitHub", href: profile.github },
  { label: "LinkedIn", href: profile.linkedin },
  { label: "Email", href: profile.email && `mailto:${profile.email}` },
].filter((l) => l.href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonical, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Apply the saved theme before the page paints, so there's no flash.
         Dark is the default until the visitor picks light with the toggle. -->
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem("theme"); } catch {}
        document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
      })();
    </script>
  </head>
  <body>
    <header class="site">
      <nav class="wrap" aria-label="Main">
        <a class="brand" href="/" aria-label={`${profile.name}, home`}>
          <Logo size={34} />
          <span class="full">{profile.name}</span>
          <span class="short" aria-hidden="true">{profile.name.replace(/\s*\(.*\)\s*$/, "")}</span>
        </a>
        <div class="menu">
          {profile.open_to_work && (
            <span class="open-to-work"><span class="dot" aria-hidden="true"></span>Open to work</span>
          )}
          <button class="theme-toggle" type="button" aria-label="Switch colour theme" hidden>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap footer-inner">
        <div>
          <p class="footer-name">{profile.name}</p>
          <p>{profile.bio}</p>
        </div>
        <ul class="footer-links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={profile.resume}>Resume</a></li>
        </ul>
        <p class="footer-copy">&copy; {year} {profile.name}</p>
      </div>
    </footer>

    <script>
      // Light/dark toggle. Remembers the choice in this browser.
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

      if (button) {
        const updateLabel = () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          button.setAttribute("aria-label", `Switch to ${next} mode`);
        };
        button.hidden = false; // only shown when JavaScript is running
        updateLabel();
        button.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch {}
          updateLabel();
        });
      }
    </script>
  </body>
</html>
