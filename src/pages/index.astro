---
// Page layout. To change the text, edit src/content.ts instead.
import "../styles.css";
import { site, type Project } from "../content";

const projects: Project[] = site.projects;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="description" content={site.tagline} />
  </head>
  <body>
    <header>
      <nav class="wrap">
        <a class="brand" href="#">{site.name}</a>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main class="wrap">
      <div class="hero">
        <h1>{site.greeting}</h1>
        <p>{site.tagline}</p>
        <a class="btn" href="#projects">View my work</a>
        <a class="btn secondary" href="#contact">Get in touch</a>
      </div>

      <section id="about">
        <h2>About</h2>
        {site.about.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section id="projects">
        <h2>Projects</h2>
        <div class="grid">
          {projects.map((project) => (
            <article class="card">
              <h3>
                {project.link ? (
                  <a href={project.link} target="_blank" rel="noopener">{project.title}</a>
                ) : (
                  project.title
                )}
              </h3>
              <p>{project.description}</p>
              <div class="tags">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <ul class="links">
          {site.links.map((link) => (
            <li><a href={link.url} target="_blank" rel="noopener">{link.label}</a></li>
          ))}
        </ul>
      </section>
    </main>

    <footer>
      <div class="wrap">&copy; {year} {site.name}</div>
    </footer>
  </body>
</html>
