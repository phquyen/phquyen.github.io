---
// /resume: built from src/content/profile.yaml (experience, skills, education).
// Empty sections are hidden. "Save as PDF" uses the browser's print dialog.
import Base from "../layouts/Base.astro";
import { getProfile } from "../lib/content";

const profile = await getProfile();
const { experience, skills, education } = profile;
const contacts = [
  profile.email && { label: profile.email, href: `mailto:${profile.email}` },
  profile.github && { label: profile.github.replace(/^https?:\/\/(www\.)?/, ""), href: profile.github },
  profile.linkedin && { label: profile.linkedin.replace(/^https?:\/\/(www\.)?/, ""), href: profile.linkedin },
].filter((c): c is { label: string; href: string } => Boolean(c));
const isEmpty = experience.length + skills.length + education.length === 0;
---

<Base title="Resume" description={`Resume of ${profile.name}.`}>
  <div class="page-title resume-head">
    <div>
      <h1>{profile.name}</h1>
      <p>{profile.bio}</p>
      {contacts.length > 0 && (
        <p class="resume-links">
          {contacts.map((c, i) => <>{i > 0 && " · "}<a href={c.href}>{c.label}</a></>)}
        </p>
      )}
    </div>
    {!isEmpty && <button class="btn secondary print-button" type="button" hidden>Save as PDF</button>}
  </div>

  {isEmpty && <p class="empty">Resume details coming soon.</p>}

  {experience.length > 0 && (
    <section class="resume-section">
      <h2>Experience</h2>
      {experience.map((job) => (
        <article class="entry">
          <div class="entry-head">
            <h3>{job.role} · {job.organisation}</h3>
            <span class="when">{job.start} – {job.end}</span>
          </div>
          {job.location && <p class="where">{job.location}</p>}
          {job.points.length > 0 && <ul>{job.points.map((point) => <li>{point}</li>)}</ul>}
        </article>
      ))}
    </section>
  )}

  {skills.length > 0 && (
    <section class="resume-section">
      <h2>Skills</h2>
      <ul class="tags">{skills.map((skill) => <li>{skill}</li>)}</ul>
    </section>
  )}

  {education.length > 0 && (
    <section class="resume-section">
      <h2>Education</h2>
      {education.map((study) => (
        <article class="entry">
          <div class="entry-head">
            <h3>{study.qualification} · {study.institution}</h3>
            {study.year && <span class="when">{study.year}</span>}
          </div>
          {study.note && <p class="where">{study.note}</p>}
        </article>
      ))}
    </section>
  )}
</Base>

<script>
  const button = document.querySelector<HTMLButtonElement>(".print-button");
  if (button) {
    button.hidden = false;
    button.addEventListener("click", () => window.print());
  }
</script>
